      "version_id": "ver_d617676bd8d0",
      "chunk_idx": 4,
      "chunk_type": "table",
      "text_content": "<table>\n  <tr>\n   <td>CWEs Mapped\n   </td>\n   <td>Max Incidence Rate\n   </td>\n   <td>Avg Incidence Rate\n   </td>\n   <td>Max Coverage\n   </td>\n   <td>Avg Coverage\n   </td>\n   <td>Avg Weighted Exploit\n   </td>\n   <td>Avg Weighted Impact\n   </td>\n   <td>Total Occurrences\n   </td>\n   <td>Total CVEs\n   </td>\n  </tr>\n  <tr>\n   <td>37\n   </td>\n   <td>13.77%\n   </td>\n   <td>3.08%\n   </td>\n   <td>100.00%\n   </td>\n   <td>42.93%\n   </td>\n   <td>7.15\n   </td>\n   <td>4.32\n   </td>\n   <td>1,404,249\n   </td>\n   <td>62,445\n   </td>\n  </tr>\n</table>",
      "token_count": 200,
      "chunk_strategy": "structure_aware",
      "heading_path": [
