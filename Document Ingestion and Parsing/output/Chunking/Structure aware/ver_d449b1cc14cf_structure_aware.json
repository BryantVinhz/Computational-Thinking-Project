    },
    {
      "chunk_id": "ver_d449b1cc14cf_c00025",
      "document_id": "doc_owasp_a03_query_parameterization_cheat_sheet",
      "version_id": "ver_d449b1cc14cf",
      "chunk_idx": 25,
      "chunk_type": "mixed",
      "text_content": "<!-- contributed by GeekMasher -->\n\n```rust\n// Input from CLI args but could be anything\nlet username = std::env::args().last().unwrap();\n\n// Using build-in macros (compile time checks)\nlet users = sqlx::query_as!(\n        User,\n        \"SELECT * FROM users WHERE name = ?\",\n        username\n    )\n    .fetch_all(&pool)\n    .await \n    .unwrap();\n\n// Using built-in functions\nlet users: Vec<User> = sqlx::query_as::<_, User>(\n        \"SELECT * FROM users WHERE name = ?\"\n    )\n    .bind(&username)\n    .fetch_all(&pool)\n    .await\n    .unwrap();\n```",
