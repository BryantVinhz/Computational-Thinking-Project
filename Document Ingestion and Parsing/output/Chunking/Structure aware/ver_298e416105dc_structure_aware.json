      "chunk_idx": 1,
      "chunk_type": "heading",
      "text_content": "## Factors",
      "token_count": 3,
      "chunk_strategy": "structure_aware",
      "heading_path": [
        "A05:2021 – Security Misconfiguration",
        "Factors"
      ]
    },
    {
      "chunk_id": "ver_298e416105dc_c00002",
      "document_id": "doc_owasp_top10_a05_security_misconfiguration",
      "version_id": "ver_298e416105dc",
      "chunk_idx": 2,
      "chunk_type": "table",
      "text_content": "| CWEs Mapped | Max Incidence Rate | Avg Incidence Rate | Avg Weighted Exploit | Avg Weighted Impact | Max Coverage | Avg Coverage | Total Occurrences | Total CVEs |\n|:-------------:|:--------------------:|:--------------------:|:--------------:|:--------------:|:----------------------:|:---------------------:|:-------------------:|:------------:|\n| 20 | 19.84% | 4.51% | 8.12 | 6.56 | 89.58% | 44.84% | 208,387 | 789 |",
      "token_count": 252,
      "chunk_strategy": "structure_aware",
      "heading_path": [
