      "chunk_idx": 1,
      "chunk_type": "paragraph",
      "text_content": "<!---\nCopyright 2021 Nokia\nLicensed under the Creative Commons Attribution-ShareAlike 3.0 Unported License\nSPDX-License-Identifier: CC-BY-SA-3.0\n--->",
      "token_count": 40,
