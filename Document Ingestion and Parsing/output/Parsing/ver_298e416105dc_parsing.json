    "file_format": "MARKDOWN",
    "block_type": "heading",
    "text_content": "## List of Mapped CWEs",
    "text_hash": "25ada4e89aaab165926a55b7c068b5ff4c988e4d4cd1593dfb340087f3d969b2",
    "parser_name": "markdown-it-py",
    "parser_version": "4.0.0",
