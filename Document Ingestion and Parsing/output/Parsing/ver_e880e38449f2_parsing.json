      "end_line": 5
    },
    "heading_path": [
      "PHP Configuration Cheat Sheet",
      "Introduction"
    ],
    "heading_level": null,
    "code_language": null,
    "lang": null,
    "table_header_cols": null,
    "table_rows": null,
    "continues_from_previous": false,
    "raw_record": null
  },
  {
