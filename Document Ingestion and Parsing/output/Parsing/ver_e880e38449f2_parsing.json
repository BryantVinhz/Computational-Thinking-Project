  {
    "block_id": "ver_e880e38449f2_b00024",
    "document_id": "doc_owasp_a05_php_configuration_cheat_sheet",
    "version_id": "ver_e880e38449f2",
    "block_idx": 24,
    "file_format": "MARKDOWN",
    "block_type": "paragraph",
    "text_content": "Session settings are some of the MOST important values to concentrate on in configuring. It is a good practice to change `session.name` to something new.",
    "text_hash": "728e1b90db64f28418525960170ac06753e6f2c4395391a80bfdd3ce0b801f28",
    "parser_name": "markdown-it-py",
    "parser_version": "4.0.0",
    "locator": {
      "start_line": 78,
      "end_line": 78
    },
    "heading_path": [
      "PHP Configuration Cheat Sheet",
      "PHP Configuration and Deployment",
      "php.ini",
      "PHP session handling"
    ],
    "heading_level": null,
    "code_language": null,
    "lang": null,
    "table_header_cols": null,
    "table_rows": null,
    "continues_from_previous": false,
    "raw_record": null
  },
  {
    "block_id": "ver_e880e38449f2_b00025",
    "document_id": "doc_owasp_a05_php_configuration_cheat_sheet",
    "version_id": "ver_e880e38449f2",
    "block_idx": 25,
    "file_format": "MARKDOWN",
    "block_type": "code",
    "text_content": "```text\n session.save_path                = /path/PHP-session/\n session.name                     = myPHPSESSID\n session.auto_start               = Off\n session.use_trans_sid            = 0\n session.cookie_domain            = full.qualified.domain.name\n #session.cookie_path             = /application/path/\n session.use_strict_mode          = 1\n session.use_cookies              = 1\n session.use_only_cookies         = 1\n session.cookie_lifetime          = 14400 # 4 hours\n session.cookie_secure            = 1\n session.cookie_httponly          = 1\n session.cookie_samesite          = Strict\n session.cache_expire             = 30\n session.sid_length               = 256\n session.sid_bits_per_character   = 6\n```",
    "text_hash": "64f61a6638fccb53fcd2c84dbd927c9ef9f4fa3760556cbf28e7571e5e326aff",
    "parser_name": "markdown-it-py",
    "parser_version": "4.0.0",
    "locator": {
