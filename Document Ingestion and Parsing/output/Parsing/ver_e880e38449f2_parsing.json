    "document_id": "doc_owasp_a05_php_configuration_cheat_sheet",
    "version_id": "ver_e880e38449f2",
    "block_idx": 3,
    "file_format": "MARKDOWN",
    "block_type": "paragraph",
    "text_content": "Below you will find information on the proper settings for the `php.ini` file and instructions on configuring Apache, Nginx, and Caddy web servers.",
    "text_hash": "76e1ed5da25aea5f8e8ac5f6e58797a2a41f46ad369ce2e64bc0f64afb89a435",
    "parser_name": "markdown-it-py",
    "parser_version": "4.0.0",
    "locator": {
      "start_line": 7,
      "end_line": 7
    },
    "heading_path": [
