    "version_id": "ver_e880e38449f2",
    "block_idx": 2,
    "file_format": "MARKDOWN",
    "block_type": "paragraph",
    "text_content": "This page is meant to help those configuring PHP and the web server it is running on to be very secure.",
    "text_hash": "fa57caf0b61019decedd42b19dcde8e0a575174f607db5cc1b541b9965f6978d",
    "parser_name": "markdown-it-py",
    "parser_version": "4.0.0",
    "locator": {
