    "file_format": "MARKDOWN",
    "block_type": "heading",
    "text_content": "# Insecure Direct Object Reference Prevention Cheat Sheet",
    "text_hash": "f22fcb855d3dc37e0d9a76513397cfd7a7a95703740b918127b745e1df2dc7d2",
    "parser_name": "markdown-it-py",
    "parser_version": "4.0.0",
    "locator": {
      "start_line": 1,
      "end_line": 1
    },
