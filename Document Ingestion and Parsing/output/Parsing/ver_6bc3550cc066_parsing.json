  {
    "block_id": "ver_6bc3550cc066_b00001",
    "document_id": "doc_owasp_top10_what_are_application_security_risks",
    "version_id": "ver_6bc3550cc066",
    "block_idx": 1,
    "file_format": "MARKDOWN",
    "block_type": "paragraph",
    "text_content": "Attackers can potentially use many different paths through your application to do harm to your business or organization. Each of these ways poses a potential risk that needs to be investigated.",
